# Local secret values belong in the Git-ignored .env.local.
SERV_API_KEY=
SERV_LIVE_ENABLED=1
SERV_DEV_MAX_CALLS=20
SERV_MAX_SPEND_USD=1.00
SERV_LIVE_MAX_PER_HOUR=3
# Local usage is recorded in .carrylock/serv-ledger.json by default.
# SERV_BUDGET_LEDGER_PATH=
# A Vercel deployment needs shared durable storage before it can call SERV.
# SERV_BUDGET_REDIS_URL=
# SERV_BUDGET_REDIS_TOKEN=
# SERV_BUDGET_REDIS_KEY=carrylock:serv-budget:v1
# Reserve authorization is only for a controlled final demonstration.
# SERV_FINAL_DEMO_LOCAL=1
# SERV_FINAL_DEMO_TOKEN=
